# Copy to .env for local builds. Never commit .env.

# TMDB "API Read Access Token" (read-only). Used in the browser, so it ends up in the JS bundle.
VITE_APP_TMDB_KEY=

# Optional: full URL of the GPT endpoint if the site isn't hosted on Vercel.
# VITE_GPT_API_URL=https://your-app.vercel.app/api/gpt

# --- Server-only: set these in Vercel > Project > Settings > Environment Variables ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# ALLOWED_ORIGIN=https://netflixgpt1-40ee2.web.app
