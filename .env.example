# Copy to .env for local development (`npx vercel dev`). Never commit .env.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# None of these use the VITE_ prefix, so none of them reach the browser.

# TMDB "API Read Access Token" (used by api/tmdb.js)
TMDB_KEY=

# Gemini API key (used by api/gpt.js)
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used when the main model is overloaded
# ALLOWED_ORIGIN=https://netflixgpt1-40ee2.web.app   # only if the site is hosted outside Vercel

# Optional, browser-side: base URL of the Vercel functions when the site is NOT on Vercel.
# VITE_API_BASE_URL=https://your-app.vercel.app
